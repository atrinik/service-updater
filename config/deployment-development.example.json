{
  "schema_version": 2,
  "root": "/opt/atrinik-development",
  "state": "/srv/atrinik/development",
  "backups": "/var/backups/atrinik-development",
  "state_mount": "/srv/atrinik",
  "admin_socket": "/run/atrinik-development-admin/server.sock",
  "lock": "/run/lock/atrinik-development-update.lock",
  "production_marker": "/etc/atrinik-production-migrated",
  "production_fence": "/etc/systemd/system/atrinik-runtime.service.d/production-migration-fence.conf",
  "service": "atrinik-development.service",
  "update_service": "atrinik-development-update.service",
  "update_timer": "atrinik-development-update.timer",
  "production_service": "atrinik-runtime.service",
  "container": "atrinik-development",
  "production_container": "atrinik-server",
  "legacy_guard": "atrinik_restore",
  "state_disk_serial": "REPLACE_WITH_VERIFIED_DISK_SERIAL",
  "machine_id": "REPLACE_WITH_VERIFIED_MACHINE_ID",
  "state_filesystem_uuid": "REPLACE_WITH_VERIFIED_FILESYSTEM_UUID",
  "production_identity_sha256": "REPLACE_WITH_VERIFIED_PRODUCTION_CERTIFICATE_SHA256",
  "production_endpoint": "production.example.org",
  "updater_image": "ghcr.io/atrinik/service-updater@sha256:REPLACE_WITH_PUBLISHED_VERIFIED_IMAGE_DIGEST",
  "adapter": "classic",
  "release_repository": "atrinik/classic",
  "release_image": "ghcr.io/atrinik/classic-server",
  "signer_workflow": "atrinik/classic/.github/workflows/publish-development-server.yml",
  "installation_root": "/opt/service-updater",
  "release_channel": "development",
  "source_ref": "refs/heads/main",
  "discovery_tag": "development"
}
